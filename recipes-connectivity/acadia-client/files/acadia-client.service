[Unit]
Description=Acadia Client — gRPC daemon for IV&V hardware validation
After=network-online.target var-lib-acadia.mount
Wants=network-online.target var-lib-acadia.mount
# P-A10: the IV&V server is provisioned on first use (WebConfig
# Provisioning page -> /var/lib/acadia/client.conf, which lives on the
# persistent /home partition). Until then the unit is skipped, not failed;
# WebConfig restarts it after provisioning.
ConditionPathExists=/var/lib/acadia/client.conf

[Service]
Type=simple
User=acadia
Group=acadia
WorkingDirectory=/var/lib/acadia
ExecStart=/usr/bin/acadia-client --config /var/lib/acadia/client.conf
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ReadWritePaths=/var/lib/acadia
# VB-1: the embedded HAL needs to reach real hardware. Groups grant device-
# node access (see acadia-udev-rules for i2c/spi/gpio; dialout/video/audio/
# disk are stock groups); the ambient capabilities are the narrow set the
# HAL's CAN and dmesg tests need — not the CAP_SYS_RAWIO-class "raw I/O"
# capability recipes-bsp/acadia-hal/files/security.md forbids elsewhere.
SupplementaryGroups=i2c spi gpio dialout video audio disk
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYSLOG
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYSLOG

[Install]
WantedBy=multi-user.target
