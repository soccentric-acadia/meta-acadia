software =
{
    version = "@@VERSION@@";
    hardware-compatibility =["1.0"];
    // Issue #21: RSA-4096 signature.  Generated by `scripts/generate-swu-keys.sh`,
    // private key in build/CI vault only.  swupdate.cfg references
    // /etc/swupdate/swupdate-public.pem as the verifier.
    signing = "RSA";

/*
 * Raspberry Pi 5 — A/B rootfs OTA update (C1/I3: includes kernel + DTB)
 *
 * Workflow:
 *   1. pre-install.sh  identifies the inactive slot, creates
 *      /dev/swupdate-inactive symlink, records the active slot, and backs up
 *      current kernel_2712.img and DTB to *.prev for rollback.
 *   2. The "raw" handler streams rootfs.ext4.gz → inactive slot.
 *   3. kernel_2712.img and bcm2712-rpi-5-b.dtb are written to /boot/.
 *   4. post-install.sh (OS-016 tryboot) moves the kernel/DTB into
 *      /boot/<NEW>/, writes the new slot's cmdline.txt, arms autoboot.txt
 *      with boot_prefix_try=<NEW>/, and writes /boot/boot_state
 *      (tries_remaining=3, confirmed=false, prev_slot=<active>).
 *   5. postupdatecmd = /usr/lib/swupdate/reboot-tryboot.sh →
 *      `reboot "0 tryboot"`: the firmware boots the new slot ONCE via
 *      boot_prefix_try. A panic/hang consumes the tryboot flag and the next
 *      boot falls back to boot_prefix (the confirmed slot) automatically.
 *   Next boot: boot-watchdog.sh decrements tries_remaining.
 *   After apps are healthy: swupdate-bootcheck.sh makes the slot permanent
 *   (boot_prefix=<slot>/) and mirrors the slot files to the /boot root.
 */

images: (
    {
        filename   = "rootfs.ext4.gz";
        type       = "raw";
        device     = "/dev/swupdate-inactive";
        compressed = "zlib";
    },
    {
        filename = "@@KERNEL@@";
        type     = "rawfile";
        path     = "/boot/@@KERNEL@@";
    },
    {
        filename = "@@DTB@@";
        type     = "rawfile";
        path     = "/boot/@@DTB@@";
    }
);

scripts: (
    {
        filename = "pre-install.sh";
        type     = "shellscript";
        data     = "preinst";
    },
    {
        filename = "post-install.sh";
        type     = "shellscript";
        data     = "postinst";
    }
);
};
